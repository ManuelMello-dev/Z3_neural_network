# Production API security
Z3_API_TOKEN=replace-with-a-long-random-secret
Z3_REQUIRE_AUTH=true
Z3_CORS_ORIGINS=https://your-trusted-dashboard.example
Z3_RATE_LIMIT_REQUESTS=120
Z3_RATE_LIMIT_WINDOW_SECONDS=60

# Durable state
Z3_STATE_DIR=/data

# Optional external infrastructure
# QDRANT_URL=
# QDRANT_API_KEY=
# REDIS_URL=
# DATABASE_URL=
